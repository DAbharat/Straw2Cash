# ==========================================
# Straw2Cash — Python AI/ML Service Environment Configuration
# ==========================================

# Server Host & Port (Default: 8001 to avoid colliding with Go on 8000 & Java on 8080)
PORT=8001
HOST=0.0.0.0
ENVIRONMENT=development
DEBUG=true

# ------------------------------------------
# NASA FIRMS Satellite Fire-Hotspots
# ------------------------------------------
# Get your free MAP_KEY at: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# If left empty, the service automatically uses deterministic realistic fixtures for Punjab/Haryana
FIRMS_MAP_KEY=YOUR_FREE_NASA_FIRMS_MAP_KEY_HERE
FIRMS_DEFAULT_SOURCE=VIIRS_NOAA20_NRT
FIRMS_CACHE_TTL_SECONDS=1800

# ------------------------------------------
# Upstream Microservice Integration
# ------------------------------------------
GO_BACKEND_URL=http://localhost:8000
JAVA_BACKEND_URL=http://localhost:8080
UPSTREAM_TIMEOUT_SECONDS=5.0

# ------------------------------------------
# AI Model Provider (Strands Agents SDK)
# Options: "mock" (offline/zero-cost demo), "bedrock" (AWS Bedrock), "ollama" (local)
# ------------------------------------------
MODEL_PROVIDER=mock

# AWS Bedrock Configuration (when MODEL_PROVIDER=bedrock)
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_REGION=ap-south-1
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_SESSION_TOKEN=

# Local Ollama Configuration (when MODEL_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
